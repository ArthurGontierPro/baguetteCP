+(* M11-T1 SCRATCH S3: the change's KIND only; [wakes_on] reads nothing else. A trail entry
+   always shrinks its domain (I-D3), so equal bounds mean holes. *)
+let s3_bound = Domain.Bound { lo = None; hi = None }
+let s3_holes = Domain.Holes []
+let s3_kind old now =
+  if Domain.lo old <> Domain.lo now || Domain.hi old <> Domain.hi now then s3_bound
+  else s3_holes
