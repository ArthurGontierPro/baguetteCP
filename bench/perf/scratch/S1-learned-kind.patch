+(* M11-T1 SCRATCH S1 (never merged): the kind of a learned instance by id, O(1). *)
+module S1_kind = struct
+  let a = ref (Bytes.make 1024 '\000')
+  let reset () = Bytes.fill !a 0 (Bytes.length !a) '\000'
+  let set id k =
+    if id >= Bytes.length !a then (
+      let b = Bytes.make (max (id + 1) (2 * Bytes.length !a)) '\000' in
+      Bytes.blit !a 0 b 0 (Bytes.length !a);
+      a := b);
+    Bytes.set !a id k
+  let get id = if id < Bytes.length !a then Bytes.get !a id else '\000'
+end
