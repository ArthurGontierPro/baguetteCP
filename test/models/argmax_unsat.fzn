% and comes first, so no assignment satisfies the model. The refutation needs the tie-break
% that the (u - j) term of the copies carries.


array [1..2] of int: X_INTRODUCED_27_ = [-1,3];
array [1..2] of int: X_INTRODUCED_30_ = [1,-1];
var 0..4: X_INTRODUCED_17_;
var 0..4: X_INTRODUCED_18_;
var 2..3: X_INTRODUCED_19_ ::var_is_introduced ;
var 2..14: X_INTRODUCED_21_ ::var_is_introduced :: is_defined_var;
var 1..13: X_INTRODUCED_22_ ::var_is_introduced :: is_defined_var;
