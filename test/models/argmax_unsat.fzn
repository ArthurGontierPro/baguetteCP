var 0..14: X_INTRODUCED_25_ ::var_is_introduced :: is_defined_var;
var bool: X_INTRODUCED_28_ ::var_is_introduced :: is_defined_var;
var bool: X_INTRODUCED_29_ ::var_is_introduced :: is_defined_var;
array [1..3] of var int: x:: output_array([1..3]) = [X_INTRODUCED_18_,X_INTRODUCED_17_,X_INTRODUCED_18_];
array [1..3] of var int: X_INTRODUCED_24_ ::var_is_introduced  = [X_INTRODUCED_21_,X_INTRODUCED_22_,X_INTRODUCED_23_];
constraint array_int_maximum(X_INTRODUCED_25_,X_INTRODUCED_24_):: defines_var(X_INTRODUCED_25_);
constraint int_lin_le_reif(X_INTRODUCED_27_,[X_INTRODUCED_25_,X_INTRODUCED_18_],-3,true);
constraint int_lin_le_reif(X_INTRODUCED_27_,[X_INTRODUCED_25_,X_INTRODUCED_17_],-2,X_INTRODUCED_28_);
constraint int_lin_le_reif(X_INTRODUCED_27_,[X_INTRODUCED_25_,X_INTRODUCED_18_],-1,X_INTRODUCED_29_);
constraint int_lin_le(X_INTRODUCED_30_,[X_INTRODUCED_17_,X_INTRODUCED_18_],-1);
constraint int_lin_eq([3,-1],[X_INTRODUCED_18_,X_INTRODUCED_21_],-2):: defines_var(X_INTRODUCED_21_);
constraint int_lin_eq([3,-1],[X_INTRODUCED_17_,X_INTRODUCED_22_],-1):: defines_var(X_INTRODUCED_22_);
constraint int_lin_eq([3,-1],[X_INTRODUCED_18_,X_INTRODUCED_23_],0):: defines_var(X_INTRODUCED_23_);
