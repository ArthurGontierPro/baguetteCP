% M18-coverage-T9 step 2 (D-0269): the table gap line on an optimisation. indomain_max on
% x finds z = 5 first; the improving bound z <= 4 settles over z's removed values 2..4
% to z <= 1, which rests on T2's rows and x's gap 3..8.
predicate baguette_table(array [int] of var int: x,array [int] of int: t,array [int] of var bool: s);
var 1..10: x :: output_var;
var 1..3: y :: output_var;
var 1..5: z :: output_var;
array [1..4] of var bool: s :: output_array([1..4]);
array [1..7] of var bool: u :: output_array([1..7]);
constraint baguette_table([x, y], [1, 1, 2, 2, 9, 3, 10, 1], s);
constraint baguette_table([x, z], [1, 1, 2, 1, 3, 3, 5, 3, 8, 3, 9, 5, 10, 5], u);
solve :: int_search([x], input_order, indomain_max, complete) minimize z;
