% M7-T28 (D-0146): flattened by MiniZinc 2.10.1 with baguette's mznlib from
% mznlib/test/gcc_closed_src_unsat.mzn. Three variables closed over {1, 3} with both
% counts at most 1: the implied row sum of the counts = 3 refutes it against the counts'
% bounds at the root.
predicate baguette_global_cardinality(array [int] of var int: x,array [int] of int: cover,array [int] of var int: counts);
array [1..2] of int: X_INTRODUCED_21_ = [1,3];
array [1..2] of int: X_INTRODUCED_23_ = [1,1];
var {1,3}: X_INTRODUCED_16_;
var {1,3}: X_INTRODUCED_17_;
var {1,3}: X_INTRODUCED_18_;
var 0..1: X_INTRODUCED_19_;
var 0..1: X_INTRODUCED_20_;
array [1..3] of var int: x:: output_array([1..3]) = [X_INTRODUCED_16_,X_INTRODUCED_17_,X_INTRODUCED_18_];
array [1..2] of var int: c:: output_array([1..2]) = [X_INTRODUCED_19_,X_INTRODUCED_20_];
constraint baguette_global_cardinality(x,X_INTRODUCED_21_,c);
constraint int_lin_eq(X_INTRODUCED_23_,[X_INTRODUCED_19_,X_INTRODUCED_20_],3);
solve  satisfy;
