% M7-T28 (D-0146): flattened by MiniZinc 2.10.1 with baguette's mznlib from
% mznlib/test/gcc_low_up_closed_src_unsat.mzn. Three variables closed over {2, 4, 6} with
% each value at most once must take all three, and their sum is forbidden to be 12.
predicate baguette_global_cardinality(array [int] of var int: x,array [int] of int: cover,array [int] of var int: counts);
array [1..3] of int: X_INTRODUCED_19_ = [1,1,1];
array [1..3] of int: X_INTRODUCED_21_ = [2,4,6];
var {2,4,6}: X_INTRODUCED_16_;
var {2,4,6}: X_INTRODUCED_17_;
var {2,4,6}: X_INTRODUCED_18_;
var 0..1: X_INTRODUCED_22_ ::var_is_introduced ;
var 0..1: X_INTRODUCED_23_ ::var_is_introduced ;
var 0..1: X_INTRODUCED_24_ ::var_is_introduced ;
array [1..3] of var int: x:: output_array([1..3]) = [X_INTRODUCED_16_,X_INTRODUCED_17_,X_INTRODUCED_18_];
array [1..3] of var int: X_INTRODUCED_25_ ::var_is_introduced  = [X_INTRODUCED_22_,X_INTRODUCED_23_,X_INTRODUCED_24_];
constraint baguette_global_cardinality(x,X_INTRODUCED_21_,X_INTRODUCED_25_);
constraint int_lin_eq(X_INTRODUCED_19_,[X_INTRODUCED_22_,X_INTRODUCED_23_,X_INTRODUCED_24_],3);
constraint int_lin_ne(X_INTRODUCED_19_,[X_INTRODUCED_16_,X_INTRODUCED_17_,X_INTRODUCED_18_],12);
solve  satisfy;
