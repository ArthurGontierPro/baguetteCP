% M7-T28 (D-0146): flattened by MiniZinc 2.10.1 with baguette's mznlib from
% mznlib/test/regular_opt_src.mzn. A six-day roster (1 off, 2 day, 3 night) where a night
% is followed by a day off, maximising the sum of the codes: the optimum 13 needs search
% and a bound proof below the root.
predicate baguette_regular(array [int] of var int: x,int: Q,int: smin,array [int] of int: d,int: q0,array [int] of int: F,array [int] of var bool: s);
array [1..2] of int: X_INTRODUCED_39_ = [1,2];
array [1..6] of int: X_INTRODUCED_40_ = [1,1,2,1,0,0];
var 1..3: X_INTRODUCED_16_;
var 1..3: X_INTRODUCED_17_;
var 1..3: X_INTRODUCED_18_;
var 1..3: X_INTRODUCED_19_;
var 1..3: X_INTRODUCED_20_;
var 1..3: X_INTRODUCED_21_;
var 6..18: total:: is_defined_var;
var bool: X_INTRODUCED_25_ ::var_is_introduced ;
var bool: X_INTRODUCED_26_ ::var_is_introduced ;
var bool: X_INTRODUCED_27_ ::var_is_introduced ;
var bool: X_INTRODUCED_28_ ::var_is_introduced ;
var bool: X_INTRODUCED_29_ ::var_is_introduced ;
var bool: X_INTRODUCED_30_ ::var_is_introduced ;
var bool: X_INTRODUCED_31_ ::var_is_introduced ;
var bool: X_INTRODUCED_32_ ::var_is_introduced ;
var bool: X_INTRODUCED_33_ ::var_is_introduced ;
var bool: X_INTRODUCED_34_ ::var_is_introduced ;
var bool: X_INTRODUCED_35_ ::var_is_introduced ;
var bool: X_INTRODUCED_36_ ::var_is_introduced ;
var bool: X_INTRODUCED_37_ ::var_is_introduced ;
var bool: X_INTRODUCED_38_ ::var_is_introduced ;
array [1..6] of var int: x:: output_array([1..6]) = [X_INTRODUCED_16_,X_INTRODUCED_17_,X_INTRODUCED_18_,X_INTRODUCED_19_,X_INTRODUCED_20_,X_INTRODUCED_21_];
array [1..14] of var bool: X_INTRODUCED_24_ ::var_is_introduced  = [X_INTRODUCED_25_,X_INTRODUCED_26_,X_INTRODUCED_27_,X_INTRODUCED_28_,X_INTRODUCED_29_,X_INTRODUCED_30_,X_INTRODUCED_31_,X_INTRODUCED_32_,X_INTRODUCED_33_,X_INTRODUCED_34_,X_INTRODUCED_35_,X_INTRODUCED_36_,X_INTRODUCED_37_,X_INTRODUCED_38_];
constraint baguette_regular(x,2,1,X_INTRODUCED_40_,1,X_INTRODUCED_39_,X_INTRODUCED_24_);
constraint int_lin_eq([1,1,1,1,1,1,-1],[X_INTRODUCED_16_,X_INTRODUCED_17_,X_INTRODUCED_18_,X_INTRODUCED_19_,X_INTRODUCED_20_,X_INTRODUCED_21_,total],0):: defines_var(total);
solve  maximize total;
