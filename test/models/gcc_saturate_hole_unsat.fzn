% UNSAT twin of gcc_saturate_hole_sat.fzn (M7-T24, D-0099). z and w may not take 2, so
% the one 2 the count demands must come from x or y. x = 2 saturates the value and rule
% (a)'s hole in y, with int_lin_ne's two exclusions, refutes the branch exactly as in the
% SAT twin; x = 1 and x = 3 leave y unable to take 2 either, and the count's lower side
% closes them. Every branch fails and the proof is checked.
var 1..3: x :: output_var;
var 1..3: y :: output_var;
var 1..3: z :: output_var;
var 1..3: w :: output_var;
constraint fzn_global_cardinality([x,y,z,w],[2],[1]);
constraint int_lin_ne([1,1],[x,y],3);
constraint int_lin_ne([1,1],[x,y],5);
constraint int_ne(z,2);
constraint int_ne(w,2);
solve :: int_search([x,y,z,w], input_order, indomain_median, complete) satisfy;
