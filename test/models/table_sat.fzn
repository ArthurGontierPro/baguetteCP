% M18-coverage-T1 (D-0206): flattened by MiniZinc 2.10.1 with baguette's mznlib from
% mznlib/test/table_src_sat.mzn.
% Three positions over 1..5, eight tuples, and a sum and a disequality that leave two
% tuples: search kills tuples by bounds and by the hole x[2] != 3 punches.

predicate baguette_table(array [int] of var int: x,array [int] of int: t,array [int] of var bool: s);
array [1..24] of int: X_INTRODUCED_29_ = [1,2,3,1,3,5,2,3,1,2,4,4,3,1,2,3,3,3,4,2,5,5,5,1];
array [1..3] of int: X_INTRODUCED_32_ = [-1,-1,-1];
array [1..2] of int: X_INTRODUCED_33_ = [1,-1];
var 1..5: X_INTRODUCED_16_;
var {1,2,4,5}: X_INTRODUCED_17_;
var 1..5: X_INTRODUCED_18_;
var bool: X_INTRODUCED_21_ ::var_is_introduced ;
var bool: X_INTRODUCED_22_ ::var_is_introduced ;
var bool: X_INTRODUCED_23_ ::var_is_introduced ;
var bool: X_INTRODUCED_24_ ::var_is_introduced ;
var bool: X_INTRODUCED_25_ ::var_is_introduced ;
var bool: X_INTRODUCED_26_ ::var_is_introduced ;
var bool: X_INTRODUCED_27_ ::var_is_introduced ;
var bool: X_INTRODUCED_28_ ::var_is_introduced ;
array [1..3] of var int: x:: output_array([1..3]) = [X_INTRODUCED_16_,X_INTRODUCED_17_,X_INTRODUCED_18_];
array [1..8] of var bool: X_INTRODUCED_20_ ::var_is_introduced  = [X_INTRODUCED_21_,X_INTRODUCED_22_,X_INTRODUCED_23_,X_INTRODUCED_24_,X_INTRODUCED_25_,X_INTRODUCED_26_,X_INTRODUCED_27_,X_INTRODUCED_28_];
constraint baguette_table(x,X_INTRODUCED_29_,X_INTRODUCED_20_);
constraint int_lin_le(X_INTRODUCED_32_,[X_INTRODUCED_17_,X_INTRODUCED_16_,X_INTRODUCED_18_],-10);
constraint int_lin_le(X_INTRODUCED_33_,[X_INTRODUCED_16_,X_INTRODUCED_18_],-1);
solve  satisfy;
