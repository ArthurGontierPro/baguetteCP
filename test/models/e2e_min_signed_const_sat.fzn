% D-0262, from bench/fuzz/found/e2e_bridge_min_signed_sat.fzn (D-0258): array_int_minimum
% with a constant 0 last and signed variables, the same bridge defect as
% e2e_max_negconst_sat. Unique solution: x0 = -1, x2 = 2, x3 = -1.
var -1..0: x0 :: output_var;
var -1..2: x2 :: output_var;
var -1..1: x3 :: output_var;
array [1..3] of var int: A :: var_is_introduced = [x0,x2,0];
constraint array_int_minimum(x3,A);
constraint int_le(x3,-1);
constraint int_le(2,x2);
solve satisfy;
