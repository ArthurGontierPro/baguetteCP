% gcc_lu_dupcover_repeatvar_unsat -- M22-review-bugs (D-0260)
%
% The fuzz lane's find (D-0258, configs stream seed 2802 model 122, shrunk; branch
% wave104-fuzz, bench/fuzz/found/): global_cardinality_low_up through mznlib, the cover
% [2,2,2] over [x0,x0,x0]. Each count is the number of x equal to 2, so 0 or 3, and the
% first is in 1..2: UNSAT (Gecode agrees). Before D-0260 the answer was right and veripb
% REJECTED line 80 of the proof on the DEFAULT configuration: gcc.ml's memo of HIGH rows,
% keyed on the cover VALUE, justified one count's pruning by another count's row.
% Written as the native call, as the fuzz lane shrank it.

predicate baguette_global_cardinality(array [int] of var int: x,array [int] of int: cover,array [int] of var int: counts);
array [1..3] of int: X_INTRODUCED_18_ = [2,2,2];
var 0..3: x0:: output_var;
var 1..2: X_INTRODUCED_20_ ::var_is_introduced ;
var 0..1: X_INTRODUCED_21_ ::var_is_introduced ;
var 0..1: X_INTRODUCED_22_ ::var_is_introduced ;
array [1..3] of var int: X_INTRODUCED_19_ ::var_is_introduced  = [x0,x0,x0];
array [1..3] of var int: X_INTRODUCED_23_ ::var_is_introduced  = [X_INTRODUCED_20_,X_INTRODUCED_21_,X_INTRODUCED_22_];
constraint baguette_global_cardinality(X_INTRODUCED_19_,X_INTRODUCED_18_,X_INTRODUCED_23_);
solve  satisfy;
