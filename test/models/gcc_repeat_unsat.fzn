% M7-T29 (D-0146): flattened by MiniZinc 2.10.1 with baguette's mznlib from
% mznlib/test/gcc_repeat_src_unsat.mzn. The same unified pair with values 1 and 2 to occur
% once each among three cells: no assignment exists, and counting the repeat once would
% accept [1, 1, 2].
predicate baguette_global_cardinality(array [int] of var int: x,array [int] of int: cover,array [int] of var int: counts);
array [1..2] of int: X_INTRODUCED_19_ = [1,1];
array [1..2] of int: X_INTRODUCED_20_ = [1,2];
var 1..2: X_INTRODUCED_17_;
var 1..2: X_INTRODUCED_18_;
array [1..3] of var int: x:: output_array([1..3]) = [X_INTRODUCED_17_,X_INTRODUCED_17_,X_INTRODUCED_18_];
constraint baguette_global_cardinality(x,X_INTRODUCED_20_,X_INTRODUCED_19_);
solve  satisfy;
