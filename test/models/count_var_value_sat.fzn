% count_var_value_sat -- M7-T23 (D-0097)
%
% FLATTENED ARTEFACT OF A WITHDRAWN ROUTE. Flattened by MiniZinc 2.10.1 on
% 2026-10-02 from mznlib/test/count_var_value_sat.mzn against the mznlib/ of commit 04514a9,
% whose mznlib/fzn_count_eq.mzn routed the counting family to the gcc
% propagator. D-0097 measured that route on the corpus and WITHDREW it (one-value
% covers lose the decomposition's interior-value pruning and gain no cross-value
% reasoning), so neither file is in the tree any more. The body is unedited
% flattener output and the lane stays as a solver test; regenerate it only from
% 04514a9's mznlib/.
%
% WHAT IT PINS: std's own decomposition of a variable-value count, which the
% route fell back to verbatim. This lane is
%   the FALLBACK: count(x, y, n) with y a variable has no cover at flatten time,
%   so it is std's decomposition, int_eq_reif + bool2int + int_lin_eq, and NO gcc
%   call.
%

var 1..3: X_INTRODUCED_16_;
var 1..3: X_INTRODUCED_17_;
var 1..3: X_INTRODUCED_18_;
var 2..3: y:: output_var;
var bool: X_INTRODUCED_19_ ::var_is_introduced :: is_defined_var;
var 0..1: X_INTRODUCED_20_ ::var_is_introduced :: is_defined_var;
var bool: X_INTRODUCED_21_ ::var_is_introduced :: is_defined_var;
var 0..1: X_INTRODUCED_22_ ::var_is_introduced :: is_defined_var;
var bool: X_INTRODUCED_23_ ::var_is_introduced :: is_defined_var;
var 0..1: X_INTRODUCED_24_ ::var_is_introduced :: is_defined_var;
array [1..3] of var int: x:: output_array([1..3]) = [X_INTRODUCED_16_,X_INTRODUCED_17_,X_INTRODUCED_18_];
constraint int_lin_eq([-1,-1,-1],[X_INTRODUCED_20_,X_INTRODUCED_22_,X_INTRODUCED_24_],-2);
constraint int_eq_reif(X_INTRODUCED_16_,y,X_INTRODUCED_19_):: defines_var(X_INTRODUCED_19_);
constraint bool2int(X_INTRODUCED_19_,X_INTRODUCED_20_):: defines_var(X_INTRODUCED_20_);
constraint int_eq_reif(X_INTRODUCED_17_,y,X_INTRODUCED_21_):: defines_var(X_INTRODUCED_21_);
constraint bool2int(X_INTRODUCED_21_,X_INTRODUCED_22_):: defines_var(X_INTRODUCED_22_);
constraint int_eq_reif(X_INTRODUCED_18_,y,X_INTRODUCED_23_):: defines_var(X_INTRODUCED_23_);
constraint bool2int(X_INTRODUCED_23_,X_INTRODUCED_24_):: defines_var(X_INTRODUCED_24_);
solve  satisfy;
