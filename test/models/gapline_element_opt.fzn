% M18-coverage-T9 step 2 (D-0269): the gap line on an optimisation. E1 removes c's gap
% 3..8 and E2 (index c) removes r's gap 2..4, each as one line. indomain_max on i finds
% r = 5 first; the improving bound r <= 4 then settles over r's gap to r <= 1, a settle
% line resting on the gap lines, and r = 1 is optimal.
var 1..4: i :: output_var;
var 1..10: c :: output_var;
var 1..5: r :: output_var;
constraint array_int_element(i, [1, 2, 9, 10], c);
constraint array_int_element(c, [1, 1, 3, 3, 3, 3, 3, 3, 5, 5], r);
solve :: int_search([i], input_order, indomain_max, complete) minimize r;
