% D-0262, from bench/fuzz/found/e2e_solver_max_const_first_sat.fzn (D-0258): a CONSTANT first
% operand of array_int_maximum, x2 signed. Before D-0262, --e2e left the constant operand's
% selector undefined (its row was implied without it) and the at-least-one over the selectors
% had no derivation. x2 <= -1 makes the solution unique: x0 = 1, x2 = -1.
var 1..2: x0 :: output_var;
var -1..1: x2 :: output_var;
array [1..2] of var int: A :: var_is_introduced = [1,x2];
constraint array_int_maximum(x0,A);
constraint int_le(x2,-1);
solve satisfy;
