% M8-bits-encoding-T3 (D-0134, probe e1): the MIXED selector shape. m has width 1 and stays
% on the order ladder at every W; a and c go on bits at `--bits-above 0` and `8`, b at 0
% only. c <= a + 1, so a = 0, 1, 2 each leave every operand below lo(m) = 4: a Maxmin
% conflict whose `pol` cites m's D-0132 `rup` bridge pair beside the operands' `red`
% pairs. a = 3 leaves c the only operand that can reach 4, so R4 pushes c >= 4.
var 4..5: m :: output_var;
var 0..9: a :: output_var;
var 0..3: b :: output_var;
var 0..9: c :: output_var;
constraint array_int_maximum(m, [a, b, c]);
constraint int_lin_le([1, -1], [c, a], 1);
solve :: int_search([a, m, b, c], input_order, indomain_min, complete) satisfy;
