% M8-bits-encoding-T3 (D-0134, probe e1): the MIXED selector shape. m has width 1 and stays
% on the order ladder at every W; a goes on bits at `--bits-above 0` and `8`, b at 0 only.
% At the root only a can reach lo(m) = 4, so R4 pushes a >= 4 from two declared facts;
% a = 4 then lets R3 cap m. The bridges of m are D-0132's `rup` pairs, a's the `red` pair.
var 4..5: m :: output_var;
var 0..9: a :: output_var;
var 0..3: b :: output_var;
constraint array_int_maximum(m, [a, b]);
constraint int_lin_le([1, 1], [a, b], 11);
solve :: int_search([a, m, b], input_order, indomain_min, complete) satisfy;
