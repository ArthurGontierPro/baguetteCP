% D-0262, from bench/fuzz/found/e2e_bridge_max_negconst_sat.fzn (D-0258): array_int_maximum
% with a fixed NEGATIVE last operand. Before D-0262 tools/e2e/bridge.py defined operand 0's
% selector as the constant operand's flag (which cake forces) and the clause over the
% selectors had no derivation. Unique solution: x0 = 0, x1 = 0, x4 = 0.
var 0..1: x0 :: output_var;
var 0..2: x1 :: output_var;
var 0..2: x4 :: output_var;
array [1..3] of var int: A :: var_is_introduced = [x1,x0,-1];
constraint array_int_maximum(x4,A);
constraint int_le(x4,0);
solve satisfy;
