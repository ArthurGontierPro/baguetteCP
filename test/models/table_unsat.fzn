% M18-coverage-T1 (D-0206): flattened by MiniZinc 2.10.1 with baguette's mznlib from
% mznlib/test/table_src_unsat.mzn.
% Two tables sharing y, each over 1..6, and x + y + z = 12 with all three distinct:
% every combination the two tables allow either repeats a value or misses the sum.

predicate baguette_table(array [int] of var int: x,array [int] of int: t,array [int] of var bool: s);
predicate all_different_int(array [int] of var int: x);
array [1..12] of int: X_INTRODUCED_25_ = [1,2,2,4,3,6,4,1,5,3,6,5];
array [1..12] of int: X_INTRODUCED_35_ = [1,1,2,3,3,5,4,2,5,4,6,6];
array [1..3] of int: X_INTRODUCED_37_ = [1,1,1];
var 1..6: x:: output_var;
var 1..6: y:: output_var;
var 1..6: z:: output_var;
var bool: X_INTRODUCED_19_ ::var_is_introduced ;
var bool: X_INTRODUCED_20_ ::var_is_introduced ;
var bool: X_INTRODUCED_21_ ::var_is_introduced ;
var bool: X_INTRODUCED_22_ ::var_is_introduced ;
var bool: X_INTRODUCED_23_ ::var_is_introduced ;
var bool: X_INTRODUCED_24_ ::var_is_introduced ;
var bool: X_INTRODUCED_29_ ::var_is_introduced ;
var bool: X_INTRODUCED_30_ ::var_is_introduced ;
var bool: X_INTRODUCED_31_ ::var_is_introduced ;
var bool: X_INTRODUCED_32_ ::var_is_introduced ;
var bool: X_INTRODUCED_33_ ::var_is_introduced ;
var bool: X_INTRODUCED_34_ ::var_is_introduced ;
array [1..2] of var int: X_INTRODUCED_17_ ::var_is_introduced  = [x,y];
array [1..6] of var bool: X_INTRODUCED_18_ ::var_is_introduced  = [X_INTRODUCED_19_,X_INTRODUCED_20_,X_INTRODUCED_21_,X_INTRODUCED_22_,X_INTRODUCED_23_,X_INTRODUCED_24_];
array [1..2] of var int: X_INTRODUCED_27_ ::var_is_introduced  = [y,z];
array [1..6] of var bool: X_INTRODUCED_28_ ::var_is_introduced  = [X_INTRODUCED_29_,X_INTRODUCED_30_,X_INTRODUCED_31_,X_INTRODUCED_32_,X_INTRODUCED_33_,X_INTRODUCED_34_];
array [1..3] of var int: X_INTRODUCED_36_ ::var_is_introduced  = [x,y,z];
constraint baguette_table(X_INTRODUCED_17_,X_INTRODUCED_25_,X_INTRODUCED_18_);
constraint baguette_table(X_INTRODUCED_27_,X_INTRODUCED_35_,X_INTRODUCED_28_);
constraint all_different_int(X_INTRODUCED_36_);
constraint int_lin_eq(X_INTRODUCED_37_,[y,x,z],12);
solve  satisfy;
