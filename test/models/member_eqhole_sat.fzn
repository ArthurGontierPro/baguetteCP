% M7-T34 (D-0169), hand-written: the satisfiable twin of member_eqhole_unsat, so the hole
% transfers' lemmas are checked over a database that is not contradictory. x2 is the
% constant 9, so b1 is set at the root. indomain_max on w1, w2: x1 loses 5 and y loses 3,
% and each hole crosses to the other side under b1 (y <> 5, x1 <> 3: one line on two
% threshold lemmas each). p1 p2 p3 are a pigeonhole only while w2 = 3, so that branch
% fails and its lines are on the page; w2 = 0 solves with x1 = y = 6.
predicate baguette_member(array [int] of var int: x,var int: y,array [int] of var bool: b);
var 1..6: x1 :: output_var;
var 1..6: y :: output_var;
var {0,5}: w1 :: output_var;
var {0,3}: w2 :: output_var;
var 1..2: p1 :: output_var;
var 1..2: p2 :: output_var;
var 1..3: p3 :: output_var;
var bool: b1;
var bool: b2;
constraint baguette_member([x1, 9], y, [b1, b2]);
constraint int_ne(x1, w1);
constraint int_ne(y, w2);
constraint int_ne(p1, p2);
constraint int_ne(p1, p3);
constraint int_ne(p2, p3);
constraint int_lin_le([1, 1], [p3, w2], 5);
solve :: int_search([w1, w2, p1, p2, p3, x1, y], input_order, indomain_max, complete) satisfy;
