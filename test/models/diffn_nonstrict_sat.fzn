% M18-coverage-T2 (D-0213): flattened by MiniZinc 2.10.1 with baguette's mznlib from
% mznlib/test/diffn_src_nonstrict_sat.mzn.
% diffn_nonstrict with a variable width w in 0..2: the rectangle whose width may be 0 is
% left out of the projection, and maximising w gives 0.

predicate baguette_cumulative(array [int] of var int: s,array [int] of int: d,array [int] of int: r,int: b);
array [1..2] of int: X_INTRODUCED_26_ = [1,1];
array [1..2] of int: X_INTRODUCED_33_ = [1,-1];
array [1..3] of int: X_INTRODUCED_41_ = [1,1,-1];
array [1..2] of int: X_INTRODUCED_49_ = [-1,1];
var 0..1: X_INTRODUCED_16_;
var 0..2: X_INTRODUCED_17_;
var 0..2: X_INTRODUCED_18_;
var 0..2: X_INTRODUCED_21_;
var 0..2: w:: output_var;
var bool: X_INTRODUCED_34_ ::var_is_introduced :: is_defined_var;
var bool: X_INTRODUCED_36_ ::var_is_introduced :: is_defined_var;
var bool: X_INTRODUCED_38_ ::var_is_introduced :: is_defined_var;
var bool: X_INTRODUCED_39_ ::var_is_introduced :: is_defined_var;
var bool: X_INTRODUCED_40_ ::var_is_introduced :: is_defined_var;
var bool: X_INTRODUCED_42_ ::var_is_introduced :: is_defined_var;
var bool: X_INTRODUCED_43_ ::var_is_introduced :: is_defined_var;
var bool: X_INTRODUCED_44_ ::var_is_introduced :: is_defined_var;
var bool: X_INTRODUCED_45_ ::var_is_introduced :: is_defined_var;
var bool: X_INTRODUCED_46_ ::var_is_introduced :: is_defined_var;
var bool: X_INTRODUCED_47_ ::var_is_introduced :: is_defined_var;
var 0..1: X_INTRODUCED_48_ ::var_is_introduced ;
var 0..2: X_INTRODUCED_50_ ::var_is_introduced ;
array [1..3] of var int: x:: output_array([1..3]) = [X_INTRODUCED_16_,X_INTRODUCED_17_,X_INTRODUCED_18_];
array [1..3] of var int: y:: output_array([1..3]) = [0,0,X_INTRODUCED_21_];
constraint int_lin_le(X_INTRODUCED_26_,[X_INTRODUCED_18_,w],3);
constraint bool_clause([X_INTRODUCED_34_,X_INTRODUCED_36_],[]);
constraint bool_clause([X_INTRODUCED_38_,X_INTRODUCED_39_,X_INTRODUCED_40_,X_INTRODUCED_42_,X_INTRODUCED_43_],[]);
constraint bool_clause([X_INTRODUCED_38_,X_INTRODUCED_44_,X_INTRODUCED_45_,X_INTRODUCED_46_,X_INTRODUCED_47_],[]);
constraint int_lin_le(X_INTRODUCED_33_,[X_INTRODUCED_48_,X_INTRODUCED_16_],0);
constraint int_lin_le(X_INTRODUCED_49_,[X_INTRODUCED_48_,X_INTRODUCED_16_],0);
constraint int_lin_le(X_INTRODUCED_33_,[X_INTRODUCED_50_,X_INTRODUCED_17_],0);
constraint int_lin_le(X_INTRODUCED_49_,[X_INTRODUCED_50_,X_INTRODUCED_17_],0);
constraint baguette_cumulative([X_INTRODUCED_48_,X_INTRODUCED_50_],[2,1],[3,3],3);
constraint int_lin_le_reif(X_INTRODUCED_33_,[X_INTRODUCED_16_,X_INTRODUCED_17_],-2,X_INTRODUCED_34_):: defines_var(X_INTRODUCED_34_);
constraint int_lin_le_reif(X_INTRODUCED_33_,[X_INTRODUCED_17_,X_INTRODUCED_16_],-1,X_INTRODUCED_36_):: defines_var(X_INTRODUCED_36_);
constraint int_eq_reif(w,0,X_INTRODUCED_38_):: defines_var(X_INTRODUCED_38_);
constraint int_lin_le_reif(X_INTRODUCED_33_,[X_INTRODUCED_16_,X_INTRODUCED_18_],-2,X_INTRODUCED_39_):: defines_var(X_INTRODUCED_39_);
constraint int_lin_le_reif([-1],[X_INTRODUCED_21_],-3,X_INTRODUCED_40_):: defines_var(X_INTRODUCED_40_);
constraint int_lin_le_reif(X_INTRODUCED_41_,[X_INTRODUCED_18_,w,X_INTRODUCED_16_],0,X_INTRODUCED_42_):: defines_var(X_INTRODUCED_42_);
constraint int_lin_le_reif([1],[X_INTRODUCED_21_],-1,X_INTRODUCED_43_):: defines_var(X_INTRODUCED_43_);
constraint int_lin_le_reif(X_INTRODUCED_33_,[X_INTRODUCED_17_,X_INTRODUCED_18_],-1,X_INTRODUCED_44_):: defines_var(X_INTRODUCED_44_);
constraint int_lin_le_reif([-1],[X_INTRODUCED_21_],-3,X_INTRODUCED_45_):: defines_var(X_INTRODUCED_45_);
constraint int_lin_le_reif(X_INTRODUCED_41_,[X_INTRODUCED_18_,w,X_INTRODUCED_17_],0,X_INTRODUCED_46_):: defines_var(X_INTRODUCED_46_);
constraint int_lin_le_reif([1],[X_INTRODUCED_21_],-1,X_INTRODUCED_47_):: defines_var(X_INTRODUCED_47_);
solve  maximize w;
