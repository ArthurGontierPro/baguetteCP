% M18-coverage-T9 (D-0270), an UNSAT companion of ladder_mixed_sat: every bits-arm line
% holds an ORDER term, so each is written on the LADDER RULE (no bridge pair, no order
% bound line; the pol cites the bits terms' atom lines and the row, the clause follows as
% a `rup` over the ladder when an order term carries a fact, as an `ia` otherwise).
% k and m are on bits, x1..x3 on the order encoding (their all_different). The rows are
% k >= 3*x1 + 1, k + m + x2 <= 17 and m >= 3*x3 + 5: every value of x1 fails through
% them, so the refutation rests on ladder-rule lines under decisions and closes on the
% root.
var 0..30: k :: output_var;
var 0..30: m :: output_var;
var 1..4: x1 :: output_var;
var 1..4: x2 :: output_var;
var 1..4: x3 :: output_var;
constraint int_lin_le([-1, 3], [k, x1], -1);
constraint int_lin_le([1, 1, 1], [k, m, x2], 17);
constraint int_lin_le([-1, 3], [m, x3], -5);
constraint all_different_int([x1, x2, x3]);
solve :: int_search([x1, x2, x3, k, m], input_order, indomain_max, complete) satisfy;
