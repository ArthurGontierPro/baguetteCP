% M7-T25 / D-0101: the UNSAT twin of element_learn_hole_sat.fzn -- the same constraints
% with y and i confined to 1..3 and the array's fourth entry dropped, which removes the
% SAT twin's only solution family (y = i = 4, c = 1) without touching the propagation
% that reaches the element conflict. Over a contradictory model a wrong rup can be
% accepted (D-0066), so this twin guards only that the refutation still closes with the
% conflict's facts on its line; the SAT twin is the evidence that the line is right.
var 1..3: i :: output_var;
var 1..3: c :: output_var;
var 1..3: y :: output_var;
var 1..3: z :: output_var;
constraint int_ne(c, y);
constraint int_eq(i, y);
constraint array_int_element(i, [1,2,3], c);
constraint int_lin_le([1,-1],[z,y],0);
solve :: int_search([y,z], input_order, indomain_median, complete) satisfy;
