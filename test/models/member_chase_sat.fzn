% M7-T34 (D-0168), hand-written: a selector death ACROSS HOLES under search, the shape whose
% line rests on threshold lemmas written ahead (the big-M rows alone do not chase a hole).
% x1 over {1,3,5} (declared holes), x2 and y over 1..6. indomain_max on w1, w2, w3 punches
% 1, 3 and 5 out of y, so b1 dies across the holes of BOTH x1 (2, 4) and y (3, 5); OR sets
% b2, and x2 takes y's holes 3 and 5 (each a line on two lemmas) and its lower bound.
% p1 p2 p3 are a pigeonhole only while w3 = 5, so that branch fails and all of it is on
% the page; w3 = 0 solves.
predicate baguette_member(array [int] of var int: x,var int: y,array [int] of var bool: b);
var {1,3,5}: x1 :: output_var;
var 1..6: x2 :: output_var;
var 1..6: y :: output_var;
var {0,1}: w1 :: output_var;
var {0,3}: w2 :: output_var;
var {0,5}: w3 :: output_var;
var 1..2: p1 :: output_var;
var 1..2: p2 :: output_var;
var 1..3: p3 :: output_var;
var bool: b1;
var bool: b2;
constraint baguette_member([x1, x2], y, [b1, b2]);
constraint int_ne(y, w1);
constraint int_ne(y, w2);
constraint int_ne(y, w3);
constraint int_ne(p1, p2);
constraint int_ne(p1, p3);
constraint int_ne(p2, p3);
constraint int_lin_le([1, 1], [p3, w3], 7);
solve :: int_search([w1, w2, w3, p1, p2, p3, x2, y, x1], input_order, indomain_max, complete) satisfy;
