% The only model here whose output is an array, so the only one that exercises the
% `array1d(1..n, [...])` half of the FlatZinc output format (SPEC 2.2) through the CLI
% rather than through a unit test's hand-built Model.t.
%
% Unique solution, for the reason chain_sat.fzn's header gives: q[1] + q[2] = 5 and
% q[2] - q[1] = 3 force q = [1, 4], whatever order the search happens to try.
array [1..2] of int: ones = [1, 1];
array [1..2] of int: diff = [1, -1];
array [1..2] of var 0..4: q :: output_array([1..2]);
constraint int_lin_eq(ones, q, 5);
constraint int_lin_eq(diff, [q[2], q[1]], 3);
solve satisfy;
