% gcc_dupcover_distinctvars_unsat -- M22-review-bugs (D-0260)
%
% D-0260's reduction of the fuzz find to ONE ingredient: the cover [2,2,2] repeats a value,
% the array [x0,x1,x2] repeats nothing. Each count is the number of x equal to 2; the first
% is 2 and the other two are at most 1: UNSAT (Gecode agrees). Before D-0260 veripb
% REJECTED the proof in both encodings, so the repeated variable of the fuzz find is not
% needed; a repeated variable over a cover of distinct values verified.

predicate baguette_global_cardinality(array [int] of var int: x,array [int] of int: cover,array [int] of var int: counts);
var 0..3: x0:: output_var; var 0..3: x1:: output_var; var 0..3: x2:: output_var; var 2..2: c1:: output_var; var 0..1: c2:: output_var; var 0..1: c3:: output_var;
constraint baguette_global_cardinality([x0,x1,x2],[2,2,2],[c1,c2,c3]);
solve satisfy;
