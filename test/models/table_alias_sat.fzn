% M18-coverage-T1 (D-0206): flattened by MiniZinc 2.10.1 with baguette's mznlib from
% mznlib/test/table_src_alias_sat.mzn.
% x occurs twice in the table's tuple, so the instance is packed Aliased (Checking):
% only the tuples with equal first two values can hold, and y > 2 leaves one.

predicate baguette_table(array [int] of var int: x,array [int] of int: t,array [int] of var bool: s);
array [1..15] of int: X_INTRODUCED_24_ = [1,2,3,2,2,1,3,3,4,4,1,4,1,1,2];
var 1..4: x:: output_var;
var 3..4: y:: output_var;
var bool: X_INTRODUCED_19_ ::var_is_introduced ;
var bool: X_INTRODUCED_20_ ::var_is_introduced ;
var bool: X_INTRODUCED_21_ ::var_is_introduced ;
var bool: X_INTRODUCED_22_ ::var_is_introduced ;
var bool: X_INTRODUCED_23_ ::var_is_introduced ;
array [1..3] of var int: X_INTRODUCED_17_ ::var_is_introduced  = [x,x,y];
array [1..5] of var bool: X_INTRODUCED_18_ ::var_is_introduced  = [X_INTRODUCED_19_,X_INTRODUCED_20_,X_INTRODUCED_21_,X_INTRODUCED_22_,X_INTRODUCED_23_];
constraint baguette_table(X_INTRODUCED_17_,X_INTRODUCED_24_,X_INTRODUCED_18_);
solve  satisfy;
