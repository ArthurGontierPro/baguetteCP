% D-0262, from bench/fuzz/found/e2e_solver_max_const_last_sat.fzn (D-0258): a CONSTANT last
% operand of array_int_maximum, x2 signed. Before D-0262 the --e2e prefix cited @D2 of the
% constant operand's selector, never assigned, and the .pbp did not parse. Unique solution:
% x0 = 1, x2 = -1.
var 1..2: x0 :: output_var;
var -1..1: x2 :: output_var;
array [1..2] of var int: A :: var_is_introduced = [x2,1];
constraint array_int_maximum(x0,A);
constraint int_le(x2,-1);
solve satisfy;
