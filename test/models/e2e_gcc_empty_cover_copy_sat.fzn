% D-0262, from bench/fuzz/found/e2e_bridge_gcc_empty_cover_repeat_var_sat.fzn (D-0258): a gcc
% with an EMPTY cover over two repeated variables of four values, the same bridge defect as
% e2e_gcc_copy_wide_sat. Unique solution: x0 = 3, x1 = -1.
predicate baguette_global_cardinality(array [int] of var int: x,array [int] of int: cover,array [int] of var int: counts);
var 0..3: x0 :: output_var;
var -1..2: x1 :: output_var;
array [1..4] of var int: A :: var_is_introduced = [x0,x1,x0,x1];
constraint baguette_global_cardinality(A,[],[]);
constraint int_le(3,x0);
constraint int_le(x1,-1);
solve satisfy;
