% M18-coverage-T3 (D-0217): flattened by MiniZinc 2.10.1 with baguette's mznlib from
% mznlib/test/circuit_src_noroot_unsat.mzn.
% Six nodes; 4, 5 and 6 can only point among themselves, a cycle of three that avoids
% the root: refuted by the GE rows summed.


predicate all_different_int(array [int] of var int: x);
predicate baguette_circuit(array [int] of var int: xs,array [int] of var int: pos,int: root);
var 2..6: X_INTRODUCED_16_;
var {1,3,4,5,6}: X_INTRODUCED_17_;
var {1,2,4,5,6}: X_INTRODUCED_18_;
var 5..6: X_INTRODUCED_19_;
var {4,6}: X_INTRODUCED_20_;
var 4..5: X_INTRODUCED_21_;
var 1..5: X_INTRODUCED_23_ ::var_is_introduced ;
var 1..5: X_INTRODUCED_24_ ::var_is_introduced ;
var 1..5: X_INTRODUCED_25_ ::var_is_introduced ;
var 1..5: X_INTRODUCED_26_ ::var_is_introduced ;
var 1..5: X_INTRODUCED_27_ ::var_is_introduced ;
array [1..6] of var int: s:: output_array([1..6]) = [X_INTRODUCED_16_,X_INTRODUCED_17_,X_INTRODUCED_18_,X_INTRODUCED_19_,X_INTRODUCED_20_,X_INTRODUCED_21_];
constraint all_different_int(s);
constraint baguette_circuit([X_INTRODUCED_16_,X_INTRODUCED_17_,X_INTRODUCED_18_,X_INTRODUCED_19_,X_INTRODUCED_20_,X_INTRODUCED_21_],[X_INTRODUCED_23_,X_INTRODUCED_24_,X_INTRODUCED_25_,X_INTRODUCED_26_,X_INTRODUCED_27_],1);
solve :: int_search(s,input_order,indomain_max,complete) satisfy;
