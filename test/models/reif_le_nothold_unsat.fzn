% M3-T2/M3-T4, case 2 (enforce-not-hold) closing a refutation. b is forced false, so
% BWD's guard vanishes and the row is `x - y >= 1`, against `x - y <= 0`.
var 0..3: x :: output_var;
var 0..3: y :: output_var;
var bool: b :: output_var;
constraint int_le_reif(x, y, b);
constraint bool_clause([], [b]);
constraint int_lin_le([1, -1], [x, y], 0);
solve satisfy;
