% M7-T28 (D-0146): flattened by MiniZinc 2.10.1 with baguette's mznlib from
% mznlib/test/gcc_closed_src_sat.mzn. global_cardinality_closed over the cover {1, 2, 4}:
% one baguette_global_cardinality call, x on the set domain the closed cover gives it, and
% the implied row sum of the counts = 4.
predicate baguette_global_cardinality(array [int] of var int: x,array [int] of int: cover,array [int] of var int: counts);
array [1..3] of int: X_INTRODUCED_23_ = [1,2,4];
array [1..2] of int: X_INTRODUCED_26_ = [1,-1];
array [1..2] of int: X_INTRODUCED_29_ = [-1,1];
var {1,2,4}: X_INTRODUCED_16_;
var {1,2,4}: X_INTRODUCED_17_;
var {1,2,4}: X_INTRODUCED_18_;
var {1,2,4}: X_INTRODUCED_19_;
var 0..4: X_INTRODUCED_21_;
var 0..4: X_INTRODUCED_22_;
array [1..4] of var int: x:: output_array([1..4]) = [X_INTRODUCED_16_,X_INTRODUCED_17_,X_INTRODUCED_18_,X_INTRODUCED_19_];
array [1..3] of var int: c:: output_array([1..3]) = [2,X_INTRODUCED_21_,X_INTRODUCED_22_];
constraint baguette_global_cardinality(x,X_INTRODUCED_23_,c);
constraint int_lin_eq([1,1],[X_INTRODUCED_21_,X_INTRODUCED_22_],2);
constraint int_lin_le(X_INTRODUCED_26_,[X_INTRODUCED_16_,X_INTRODUCED_17_],-1);
constraint int_lin_le(X_INTRODUCED_29_,[X_INTRODUCED_18_,X_INTRODUCED_19_],-1);
solve  satisfy;
