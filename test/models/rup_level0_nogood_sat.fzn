% M7-T6: A CORRECT ANSWER WHOSE PROOF THE CHECKER REJECTS. This model is listed in
% test/models/PENDING and is expected to fail until that row lands.
%
% Nine variables, five constraints, NO global constraint. The solver answers
% xs = [1,1,9,1,1,1,2,1,1], which satisfies every constraint by inspection
% (x3=1 != x6=2; x6=2 != x7=1; -2(1)+9-1+1 = 7). veripb 3.0.2 then rejects the
% proof at the level-0 backtrack nogood on line 48:
%
%   The constraint is not implied by reverse unit propagation (RUP) from core
%   and derived database.
%
% Found by M7-T3 while measuring the MiniZinc library, and shown PRE-EXISTING
% rather than caused by keeping a global native: the same 2001 fuzz seeds gave 3
% RUP failures with all_different native and 5 with it decomposed to pairwise
% int_ne -- overlapping but not identical sets, so the defect is upstream of the
% global entirely. This reproducer has no global at all, which is why it is the
% one to debug.
%
% This is M1-T44's shape, which this project once called its highest-priority
% open defect: the answer is right, every step looks valid, and the artefact is
% the thing that is wrong. Do not fix it by adjusting the expected output.
var 1..11: x0;
var 1..11: x1;
var 1..11: x2;
var 1..11: x3;
var 1..11: x4;
var 1..11: x5;
var 1..11: x6;
var 1..11: x7;
var 1..11: x8;
var bool: b0;
var bool: b1;
var bool: b2;
var 0..11: y0;
var 0..11: y1;
array [1..9] of var int: xs:: output_array([1..9]) = [x0,x1,x2,x3,x4,x5,x6,x7,x8];
constraint int_ne(x3,x6);
constraint int_ne(x6,x7);
constraint int_lin_eq([-2,1,-1,1],[x7,x2,x8,x0],7);
constraint int_lin_le_reif([-2,-2],[x3,x6],-9,b0);
constraint int_lin_le_reif([2,1,-1,-1],[x7,x1,x0,x2],6,b1);
solve satisfy;
