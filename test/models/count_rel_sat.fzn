% count_rel_sat -- M7-T23 (D-0097)
%
% FLATTENED ARTEFACT OF A WITHDRAWN ROUTE. Flattened by MiniZinc 2.10.1 on
% 2026-10-02 from mznlib/test/count_rel_sat.mzn against the mznlib/ of commit 04514a9,
% whose mznlib/fzn_count_eq.mzn routed the counting family to the gcc
% propagator. D-0097 measured that route on the corpus and WITHDREW it (one-value
% covers lose the decomposition's interior-value pruning and gain no cross-value
% reasoning), so neither file is in the tree any more. The body is unedited
% flattener output and the lane stays as a solver test; regenerate it only from
% 04514a9's mznlib/.
%
% WHAT IT PINS: one-value-cover baguette_global_cardinality calls as that route
% emitted them. This lane is
%   count_leq/geq/lt/gt/neq, which std writes as z = count(x, v) then z OP n: the
%   relational side folds into the count's declared domain (2..5, 0..1, 1..2) or
%   stays a row (int_lin_ne), and each count is a gcc call.
%

predicate baguette_global_cardinality(array [int] of var int: x,array [int] of int: cover,array [int] of var int: counts);
array [1..1] of int: X_INTRODUCED_23_ = [1];
array [1..1] of int: X_INTRODUCED_26_ = [2];
array [1..1] of int: X_INTRODUCED_29_ = [3];
array [1..2] of int: X_INTRODUCED_30_ = [1,-1];
var 1..3: X_INTRODUCED_16_;
var 1..3: X_INTRODUCED_17_;
var 1..3: X_INTRODUCED_18_;
var 1..3: X_INTRODUCED_19_;
var 1..3: X_INTRODUCED_20_;
var 4..5: m:: output_var;
var 2..5: X_INTRODUCED_21_ ::var_is_introduced ;
var 0..1: X_INTRODUCED_24_ ::var_is_introduced ;
var 1..2: X_INTRODUCED_27_ ::var_is_introduced ;
array [1..5] of var int: x:: output_array([1..5]) = [X_INTRODUCED_16_,X_INTRODUCED_17_,X_INTRODUCED_18_,X_INTRODUCED_19_,X_INTRODUCED_20_];
array [1..1] of var int: X_INTRODUCED_22_ ::var_is_introduced  = [X_INTRODUCED_21_];
array [1..1] of var int: X_INTRODUCED_25_ ::var_is_introduced  = [X_INTRODUCED_24_];
array [1..1] of var int: X_INTRODUCED_28_ ::var_is_introduced  = [X_INTRODUCED_27_];
constraint baguette_global_cardinality(x,X_INTRODUCED_23_,X_INTRODUCED_22_);
constraint baguette_global_cardinality(x,X_INTRODUCED_26_,X_INTRODUCED_25_);
constraint baguette_global_cardinality(x,X_INTRODUCED_29_,X_INTRODUCED_28_);
constraint int_lin_ne(X_INTRODUCED_30_,[X_INTRODUCED_21_,m],0);
solve  satisfy;
