% D-0262, from the fuzz e2e stream (seed 10100 model 54): int_lin_ne whose disequality can never
% be violated (x3 - x0 <= 3 < 5) beside an int_eq_reif over the same two variables, x0 signed.
% tools/e2e/bridge.py defined int_lin_ne's selector as the reification's flag, proposed by the
% selector's first row, which is true outright; then derived the reification's big-M row by
% contradiction from int_lin_ne's candidate, which unit propagation did not close. Both paths
% verify since D-0262 (without the all_different, main verifies it too). Unique solution:
% x0 = 1, x3 = -1, x2 = 1, b0 = false.
var -1..1: x0 :: output_var;
var -1..2: x3 :: output_var;
var 1..4: x2 :: output_var;
var bool: b0 :: output_var;
array [1..2] of var int: A :: var_is_introduced = [x3,x2];
constraint all_different_int(A);
constraint int_lin_ne([1,-1],[x3,x0],5);
constraint int_eq_reif(x3,x0,b0);
constraint int_le(x3,-1);
constraint int_le(1,x0);
constraint int_le(x2,1);
solve satisfy;
