% M7-T22 / D-0086 (c): the SAT twin of alldiff_pigeonhole_narrow_unsat. The same push --
% a Hall interval reaching past the surplus variable's declared top -- happens UNDER A
% DECISION in a satisfiable model, so its derivation is a line a nogood rests on over a
% database that is not contradictory. Found by a random search over small all_different
% models (seed 173 of a scratch generator, not bench/fuzz).
%
% Break: the pre-fix binary (sha256 a57f2961...) exits 2 with `Alldiff: d_fwd has no
% constraint id`; the fixed one finds a solution and its proof verifies.
var 1..5: x0 :: output_var;
var 1..4: x1 :: output_var;
var 1..3: x2 :: output_var;
var 1..5: x3 :: output_var;
var 1..2: x4 :: output_var;
constraint all_different_int([x0,x1,x2,x3,x4]);
constraint int_lin_le([1,1],[x0,x1],6);
solve :: int_search([x4,x0,x2,x3,x1], first_fail, indomain_min, complete) satisfy;
