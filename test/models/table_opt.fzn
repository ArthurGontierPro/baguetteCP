% M18-coverage-T1 (D-0206): flattened by MiniZinc 2.10.1 with baguette's mznlib from
% mznlib/test/table_src_opt.mzn.
% A cost table over (item, colour) and two items that must differ in colour; minimise
% the summed cost. Exercises the proof of an optimum through the selectors.

predicate baguette_table(array [int] of var int: x,array [int] of int: t,array [int] of var bool: s);
array [1..6] of int: X_INTRODUCED_28_ = [1,4,2,2,3,7];
array [1..6] of int: X_INTRODUCED_35_ = [1,3,2,1,3,2];
array [1..2] of int: X_INTRODUCED_36_ = [1,-1];
var 1..3: X_INTRODUCED_16_;
var 1..3: X_INTRODUCED_17_;
var 0..9: X_INTRODUCED_18_;
var 0..9: X_INTRODUCED_19_;
var 0..18: X_INTRODUCED_20_:: is_defined_var;
var bool: X_INTRODUCED_25_ ::var_is_introduced ;
var bool: X_INTRODUCED_26_ ::var_is_introduced ;
var bool: X_INTRODUCED_27_ ::var_is_introduced ;
var bool: X_INTRODUCED_32_ ::var_is_introduced ;
var bool: X_INTRODUCED_33_ ::var_is_introduced ;
var bool: X_INTRODUCED_34_ ::var_is_introduced ;
array [1..2] of var int: c:: output_array([1..2]) = [X_INTRODUCED_16_,X_INTRODUCED_17_];
array [1..2] of var int: cost:: output_array([1..2]) = [X_INTRODUCED_18_,X_INTRODUCED_19_];
array [1..2] of var int: X_INTRODUCED_23_ ::var_is_introduced  = [X_INTRODUCED_16_,X_INTRODUCED_18_];
array [1..3] of var bool: X_INTRODUCED_24_ ::var_is_introduced  = [X_INTRODUCED_25_,X_INTRODUCED_26_,X_INTRODUCED_27_];
array [1..2] of var int: X_INTRODUCED_30_ ::var_is_introduced  = [X_INTRODUCED_17_,X_INTRODUCED_19_];
array [1..3] of var bool: X_INTRODUCED_31_ ::var_is_introduced  = [X_INTRODUCED_32_,X_INTRODUCED_33_,X_INTRODUCED_34_];
constraint baguette_table(X_INTRODUCED_23_,X_INTRODUCED_28_,X_INTRODUCED_24_);
constraint baguette_table(X_INTRODUCED_30_,X_INTRODUCED_35_,X_INTRODUCED_31_);
constraint int_lin_ne(X_INTRODUCED_36_,[X_INTRODUCED_16_,X_INTRODUCED_17_],0);
constraint int_lin_eq([1,1,-1],[X_INTRODUCED_18_,X_INTRODUCED_19_,X_INTRODUCED_20_],0):: ctx_neg:: defines_var(X_INTRODUCED_20_);
solve  minimize X_INTRODUCED_20_;
