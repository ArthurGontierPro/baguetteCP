% gcc_dupcover_distinctvars_sat -- M22-review-bugs (D-0260)
%
% The SAT twin of gcc_dupcover_distinctvars_unsat: the first count in 1..2, so exactly one
% x is 2 and every count is 1 (Gecode: SAT). Before D-0260 veripb REJECTED the proof.

predicate baguette_global_cardinality(array [int] of var int: x,array [int] of int: cover,array [int] of var int: counts);
var 0..3: x0:: output_var; var 0..3: x1:: output_var; var 0..3: x2:: output_var; var 1..2: c1:: output_var; var 0..1: c2:: output_var; var 0..1: c3:: output_var;
constraint baguette_global_cardinality([x0,x1,x2],[2,2,2],[c1,c2,c3]);
solve satisfy;
