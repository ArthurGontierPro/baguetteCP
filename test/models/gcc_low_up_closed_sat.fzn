% M7-T28 (D-0146): flattened by MiniZinc 2.10.1 with baguette's mznlib from
% mznlib/test/gcc_low_up_closed_src_sat.mzn. global_cardinality_low_up_closed over {1, 3,
% 5}, each value once or twice: counts declared on their bounds, x restricted to the
% cover, the implied row over the counts.
predicate baguette_global_cardinality(array [int] of var int: x,array [int] of int: cover,array [int] of var int: counts);
array [1..3] of int: X_INTRODUCED_22_ = [1,1,1];
array [1..3] of int: X_INTRODUCED_23_ = [1,3,5];
array [1..2] of int: X_INTRODUCED_29_ = [-1,1];
array [1..2] of int: X_INTRODUCED_30_ = [1,-1];
var {1,3,5}: X_INTRODUCED_16_;
var {1,3,5}: X_INTRODUCED_17_;
var {1,3,5}: X_INTRODUCED_18_;
var {1,3,5}: X_INTRODUCED_19_;
var {1,3,5}: X_INTRODUCED_20_;
var 1..2: X_INTRODUCED_24_ ::var_is_introduced ;
var 1..2: X_INTRODUCED_25_ ::var_is_introduced ;
var 1..2: X_INTRODUCED_26_ ::var_is_introduced ;
array [1..5] of var int: x:: output_array([1..5]) = [X_INTRODUCED_16_,X_INTRODUCED_17_,X_INTRODUCED_18_,X_INTRODUCED_19_,X_INTRODUCED_20_];
array [1..3] of var int: X_INTRODUCED_27_ ::var_is_introduced  = [X_INTRODUCED_24_,X_INTRODUCED_25_,X_INTRODUCED_26_];
constraint baguette_global_cardinality(x,X_INTRODUCED_23_,X_INTRODUCED_27_);
constraint int_lin_eq(X_INTRODUCED_22_,[X_INTRODUCED_24_,X_INTRODUCED_25_,X_INTRODUCED_26_],5);
constraint int_lin_le(X_INTRODUCED_29_,[X_INTRODUCED_16_,X_INTRODUCED_17_],-1);
constraint int_lin_le(X_INTRODUCED_29_,[X_INTRODUCED_17_,X_INTRODUCED_18_],-1);
constraint int_lin_le(X_INTRODUCED_30_,[X_INTRODUCED_19_,X_INTRODUCED_20_],-1);
solve  satisfy;
