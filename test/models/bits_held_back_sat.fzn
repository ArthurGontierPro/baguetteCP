% M8-bits-encoding-T2 (D-0130 section 3.4, D-0132 section 2.7): the scope rule. a and b
% are wide enough for bits at `--bits-above 0` but sit in an all_different scope, so they
% keep the order encoding at every W (`--stats` reports `held back: alldiff: 2`); c is
% eligible and goes on bits; w has width 1 and stays order by rule. The artefacts at
% W = 0 therefore differ from W = none only on c's rows.
var 0..9: a :: output_var;
var 0..9: b :: output_var;
var 0..9: c :: output_var;
var 0..1: w :: output_var;
constraint all_different_int([a, b]);
constraint int_lin_le([1, 1, 1], [a, b, c], 12);
constraint int_lin_le([-1, -1], [c, w], -9);
solve satisfy;
