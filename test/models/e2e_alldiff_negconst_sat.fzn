% D-0262, from bench/fuzz/found/e2e_solver_alldiff_negconst_sat.fzn (D-0258): all_different
% with a negative and a positive constant among variables. Before D-0262 --e2e defined the
% selector of the pair (-1, x5) as cake's flag of the pair (4, x5), on a row of degree 0 that
% any candidate implies, and the next row was refused. Unique solution: x1 = 2, x5 = 3.
var 1..4: x1 :: output_var;
var 1..3: x5 :: output_var;
array [1..4] of var int: A :: var_is_introduced = [x1,-1,4,x5];
constraint all_different_int(A);
constraint int_lt(x1,x5);
constraint int_lin_eq([1,1],[x1,x5],5);
solve satisfy;
