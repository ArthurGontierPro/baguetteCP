% M7-T28 (D-0159): flattened by MiniZinc 2.10.1 with baguette's mznlib from
% mznlib/test/member_src_unsat.mzn. Three odd values and y = x[1] + x[2], which is even,
% one of them: a parity argument, refuted through selector deaths across the holes.
predicate baguette_member(array [int] of var int: x,var int: y,array [int] of var bool: b);
array [1..3] of int: X_INTRODUCED_25_ = [1,-1,-1];
var {1,3,5}: X_INTRODUCED_16_;
var {1,3,5}: X_INTRODUCED_17_;
var {1,3,5}: X_INTRODUCED_18_;
var 2..6: y:: output_var:: is_defined_var;
var bool: X_INTRODUCED_20_ ::var_is_introduced ;
var bool: X_INTRODUCED_21_ ::var_is_introduced ;
var bool: X_INTRODUCED_22_ ::var_is_introduced ;
array [1..3] of var int: x:: output_array([1..3]) = [X_INTRODUCED_16_,X_INTRODUCED_17_,X_INTRODUCED_18_];
array [1..3] of var bool: X_INTRODUCED_19_ ::var_is_introduced  = [X_INTRODUCED_20_,X_INTRODUCED_21_,X_INTRODUCED_22_];
constraint baguette_member(x,y,X_INTRODUCED_19_);
constraint int_lin_eq(X_INTRODUCED_25_,[y,X_INTRODUCED_16_,X_INTRODUCED_17_],0):: defines_var(y);
solve  satisfy;
