% propagator. This lane is
%   at_most(1, x, 1) and at_most(1, x, 2): std's count(x, v) <= n, which MiniZinc
%   folds into the count's domain 0..1.
%

predicate baguette_global_cardinality(array [int] of var int: x,array [int] of int: cover,array [int] of var int: counts);
array [1..1] of int: X_INTRODUCED_21_ = [1];
array [1..1] of int: X_INTRODUCED_24_ = [2];
array [1..2] of int: X_INTRODUCED_25_ = [1,-1];
var 1..3: X_INTRODUCED_16_;
var 1..3: X_INTRODUCED_17_;
var 1..3: X_INTRODUCED_18_;
var 0..1: X_INTRODUCED_19_ ::var_is_introduced ;
var 0..1: X_INTRODUCED_22_ ::var_is_introduced ;
array [1..3] of var int: x:: output_array([1..3]) = [X_INTRODUCED_16_,X_INTRODUCED_17_,X_INTRODUCED_18_];
array [1..1] of var int: X_INTRODUCED_20_ ::var_is_introduced  = [X_INTRODUCED_19_];
array [1..1] of var int: X_INTRODUCED_23_ ::var_is_introduced  = [X_INTRODUCED_22_];
constraint baguette_global_cardinality(x,X_INTRODUCED_21_,X_INTRODUCED_20_);
constraint baguette_global_cardinality(x,X_INTRODUCED_24_,X_INTRODUCED_23_);
constraint int_lin_le(X_INTRODUCED_25_,[X_INTRODUCED_16_,X_INTRODUCED_18_],-1);
solve  satisfy;
