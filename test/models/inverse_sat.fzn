% M7-T28 (D-0151): flattened by MiniZinc 2.10.1 with baguette's mznlib from
% mznlib/test/inverse_src_sat.mzn. Two permutations of 1..5, each the other's inverse, f with
% no fixed point, g[2] = 4, f[1] < f[5]: one baguette_inverse call.
predicate baguette_inverse(array [int] of var int: f,int: fmin,array [int] of var int: g,int: gmin);
array [1..2] of int: X_INTRODUCED_26_ = [1,-1];
var 2..5: X_INTRODUCED_16_;
var {1,3,4,5}: X_INTRODUCED_17_;
var {1,2,4,5}: X_INTRODUCED_18_;
var {1,2,3,5}: X_INTRODUCED_19_;
var 1..4: X_INTRODUCED_20_;
var 1..5: X_INTRODUCED_21_;
var 1..5: X_INTRODUCED_23_;
var 1..5: X_INTRODUCED_24_;
var 1..5: X_INTRODUCED_25_;
array [1..5] of var int: f:: output_array([1..5]) = [X_INTRODUCED_16_,X_INTRODUCED_17_,X_INTRODUCED_18_,X_INTRODUCED_19_,X_INTRODUCED_20_];
array [1..5] of var int: g:: output_array([1..5]) = [X_INTRODUCED_21_,4,X_INTRODUCED_23_,X_INTRODUCED_24_,X_INTRODUCED_25_];
constraint baguette_inverse(f,1,g,1);
constraint int_lin_le(X_INTRODUCED_26_,[X_INTRODUCED_16_,X_INTRODUCED_20_],-1);
solve  satisfy;
