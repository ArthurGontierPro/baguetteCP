% M10-search-strategy-T2 (D-0137): 5 pigeons, 4 holes, 0/1 cells. UNSAT, and its refutation
% takes conflicts that LEARN, so under --restarts the search restarts in the middle and
% the root closes in a later run. scripts/run_model_tests.sh runs every restart_*.fzn a
% second time with --restarts luby:1 --phase-saving --search alternate and checks that
% proof too. Domains of width 1 (CLAUDE.md).
var 0..1: x11 :: output_var;
var 0..1: x12 :: output_var;
var 0..1: x13 :: output_var;
var 0..1: x14 :: output_var;
var 0..1: x21 :: output_var;
var 0..1: x22 :: output_var;
var 0..1: x23 :: output_var;
var 0..1: x24 :: output_var;
var 0..1: x31 :: output_var;
var 0..1: x32 :: output_var;
var 0..1: x33 :: output_var;
var 0..1: x34 :: output_var;
var 0..1: x41 :: output_var;
var 0..1: x42 :: output_var;
var 0..1: x43 :: output_var;
var 0..1: x44 :: output_var;
var 0..1: x51 :: output_var;
var 0..1: x52 :: output_var;
var 0..1: x53 :: output_var;
var 0..1: x54 :: output_var;
constraint int_lin_eq([1,1,1,1],[x11,x12,x13,x14],1);
constraint int_lin_eq([1,1,1,1],[x21,x22,x23,x24],1);
constraint int_lin_eq([1,1,1,1],[x31,x32,x33,x34],1);
constraint int_lin_eq([1,1,1,1],[x41,x42,x43,x44],1);
constraint int_lin_eq([1,1,1,1],[x51,x52,x53,x54],1);
constraint int_lin_le([1,1,1,1,1],[x11,x21,x31,x41,x51],1);
constraint int_lin_le([1,1,1,1,1],[x12,x22,x32,x42,x52],1);
constraint int_lin_le([1,1,1,1,1],[x13,x23,x33,x43,x53],1);
constraint int_lin_le([1,1,1,1,1],[x14,x24,x34,x44,x54],1);
solve satisfy;
