% M18-coverage-T4 (D-0220): flattened by MiniZinc 2.10.1 with baguette's mznlib from
% mznlib/test/binpack_src_capa_unsat.mzn.
% Three items of weight 3 into two bins of capacity 4 and 5: the total fits (9 <= 9), no
% packing does, so the refutation needs the rows of both bins.


predicate baguette_bool_lin_le(array [int] of int: a,array [int] of var bool: x,int: c);
array [1..3] of int: X_INTRODUCED_19_ = [3,3,3];
var 1..2: X_INTRODUCED_16_;
var 1..2: X_INTRODUCED_17_;
var 1..2: X_INTRODUCED_18_;
var bool: X_INTRODUCED_21_ ::var_is_introduced :: is_defined_var;
var bool: X_INTRODUCED_22_ ::var_is_introduced :: is_defined_var;
var bool: X_INTRODUCED_23_ ::var_is_introduced :: is_defined_var;
var bool: X_INTRODUCED_24_ ::var_is_introduced :: is_defined_var;
var bool: X_INTRODUCED_25_ ::var_is_introduced :: is_defined_var;
var bool: X_INTRODUCED_26_ ::var_is_introduced :: is_defined_var;
array [1..3] of var int: x:: output_array([1..3]) = [X_INTRODUCED_16_,X_INTRODUCED_17_,X_INTRODUCED_18_];
constraint baguette_bool_lin_le(X_INTRODUCED_19_,[X_INTRODUCED_21_,X_INTRODUCED_22_,X_INTRODUCED_23_],4);
constraint baguette_bool_lin_le(X_INTRODUCED_19_,[X_INTRODUCED_24_,X_INTRODUCED_25_,X_INTRODUCED_26_],5);
constraint int_eq_reif(X_INTRODUCED_16_,1,X_INTRODUCED_21_):: defines_var(X_INTRODUCED_21_);
constraint int_eq_reif(X_INTRODUCED_17_,1,X_INTRODUCED_22_):: defines_var(X_INTRODUCED_22_);
constraint int_eq_reif(X_INTRODUCED_18_,1,X_INTRODUCED_23_):: defines_var(X_INTRODUCED_23_);
constraint int_eq_reif(X_INTRODUCED_16_,2,X_INTRODUCED_24_):: defines_var(X_INTRODUCED_24_);
constraint int_eq_reif(X_INTRODUCED_17_,2,X_INTRODUCED_25_):: defines_var(X_INTRODUCED_25_);
constraint int_eq_reif(X_INTRODUCED_18_,2,X_INTRODUCED_26_):: defines_var(X_INTRODUCED_26_);
solve  satisfy;
