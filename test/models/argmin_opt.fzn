% M18-coverage-T6 (D-0240): flattened by MiniZinc 2.10.1 with baguette's mznlib from
% mznlib/test/argmin_src_opt.mzn.
% std's arg_min pinned through baguette (copies n * y[j] + j and array_int_minimum over
% them), over an array indexed from 0, inside an objective: maximise the index of the
% minimum under a floor on the sum. The best answer puts the minimum last, and the tie rule
% (the FIRST position of the minimum) forbids any earlier position from equalling it.


predicate all_different_int(array [int] of var int: x);
array [1..2] of int: X_INTRODUCED_31_ = [1,-4];
array [1..4] of int: X_INTRODUCED_38_ = [-1,-1,-1,-1];
var 1..4: X_INTRODUCED_17_;
var 1..4: X_INTRODUCED_18_;
var 1..4: X_INTRODUCED_19_;
var 2..4: X_INTRODUCED_20_;
var 0..3: X_INTRODUCED_21_ ::var_is_introduced ;
var 4..16: X_INTRODUCED_23_ ::var_is_introduced :: is_defined_var;
var 5..17: X_INTRODUCED_24_ ::var_is_introduced :: is_defined_var;
var 6..18: X_INTRODUCED_25_ ::var_is_introduced :: is_defined_var;
var 7..19: X_INTRODUCED_26_ ::var_is_introduced :: is_defined_var;
var 4..19: X_INTRODUCED_29_ ::var_is_introduced :: is_defined_var;
var bool: X_INTRODUCED_30_ ::var_is_introduced :: is_defined_var;
var bool: X_INTRODUCED_32_ ::var_is_introduced :: is_defined_var;
var bool: X_INTRODUCED_33_ ::var_is_introduced :: is_defined_var;
var bool: X_INTRODUCED_34_ ::var_is_introduced :: is_defined_var;
array [1..4] of var int: X_INTRODUCED_16_:: output_array([1..4]) = [X_INTRODUCED_17_,X_INTRODUCED_18_,X_INTRODUCED_19_,X_INTRODUCED_20_];
array [1..4] of var int: X_INTRODUCED_28_ ::var_is_introduced  = [X_INTRODUCED_23_,X_INTRODUCED_24_,X_INTRODUCED_25_,X_INTRODUCED_26_];
array [1..2] of var int: X_INTRODUCED_36_ ::var_is_introduced  = [X_INTRODUCED_17_,X_INTRODUCED_18_];
constraint array_int_minimum(X_INTRODUCED_29_,X_INTRODUCED_28_):: defines_var(X_INTRODUCED_29_);
constraint int_lin_le_reif(X_INTRODUCED_31_,[X_INTRODUCED_29_,X_INTRODUCED_17_],-1,X_INTRODUCED_30_);
constraint int_lin_le_reif(X_INTRODUCED_31_,[X_INTRODUCED_29_,X_INTRODUCED_18_],0,X_INTRODUCED_32_);
constraint int_lin_le_reif(X_INTRODUCED_31_,[X_INTRODUCED_29_,X_INTRODUCED_19_],1,X_INTRODUCED_33_);
constraint int_lin_le_reif(X_INTRODUCED_31_,[X_INTRODUCED_29_,X_INTRODUCED_20_],2,X_INTRODUCED_34_);
constraint all_different_int(X_INTRODUCED_36_);
constraint int_lin_le(X_INTRODUCED_38_,[X_INTRODUCED_17_,X_INTRODUCED_18_,X_INTRODUCED_19_,X_INTRODUCED_20_],-11);
constraint int_lin_eq([4,-1],[X_INTRODUCED_17_,X_INTRODUCED_23_],0):: defines_var(X_INTRODUCED_23_);
constraint int_lin_eq([4,-1],[X_INTRODUCED_18_,X_INTRODUCED_24_],-1):: defines_var(X_INTRODUCED_24_);
constraint int_lin_eq([4,-1],[X_INTRODUCED_19_,X_INTRODUCED_25_],-2):: defines_var(X_INTRODUCED_25_);
constraint int_lin_eq([4,-1],[X_INTRODUCED_20_,X_INTRODUCED_26_],-3):: defines_var(X_INTRODUCED_26_);
constraint int_ne_reif(X_INTRODUCED_21_,0,X_INTRODUCED_30_):: defines_var(X_INTRODUCED_30_);
constraint int_ne_reif(X_INTRODUCED_21_,1,X_INTRODUCED_32_):: defines_var(X_INTRODUCED_32_);
constraint int_ne_reif(X_INTRODUCED_21_,2,X_INTRODUCED_33_):: defines_var(X_INTRODUCED_33_);
constraint int_ne_reif(X_INTRODUCED_21_,3,X_INTRODUCED_34_):: defines_var(X_INTRODUCED_34_);
solve  maximize X_INTRODUCED_21_;
