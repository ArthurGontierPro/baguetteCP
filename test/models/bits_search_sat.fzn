% M8-bits-encoding-T2 (D-0132): a satisfiable model that branches over bits variables
% before it lands, so `sol` carries the bits of every variable and the checker
% propagates the atoms from them (D-0130 section 9), after decisions, prunings under
% them and at least one backtrack. x = y + 3, x + y + z in 29..30 with z even.
var 0..20: x :: output_var;
var 0..20: y :: output_var;
var 0..20: z :: output_var;
var 0..10: h :: output_var;
constraint int_lin_eq([1, -1], [x, y], 3);
constraint int_lin_le([1, 1, 1], [x, y, z], 30);
constraint int_lin_le([-1, -1, -1], [x, y, z], -29);
constraint int_lin_eq([1, -2], [z, h], 0);
solve satisfy;
