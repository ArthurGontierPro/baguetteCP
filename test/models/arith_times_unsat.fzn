% The refutation has to be DERIVED, not read off one row: the declared box alone is
% satisfiable (1..3 times 2..3 reaches 2..9, and z allows 0..9), and what refutes the
% model is the guarded int_times row `z >= 2x` at v = lo(y) combined with x = 3 and
% z <= 5. A model whose .opb contains a row that is infeasible on its own tests the
% checker's willingness to read one line, not this propagator -- test_prop.ml's
% D-0030 lane asserts that this is not such a model.
var 1..3: x :: output_var;
var 2..3: y :: output_var;
var 0..9: z :: output_var;
constraint int_times(x, y, z);
constraint int_eq(x, 3);
constraint int_le(z, 5);
solve satisfy;
